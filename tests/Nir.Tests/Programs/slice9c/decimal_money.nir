fn total(price: decimal, quantity: int) -> decimal {
    return price * (quantity as decimal)
}

fn main() {
    let price: decimal = 19.99
    let sum = total(price, 3)
    print(sum)
    print(sum / 3.0 == price)
    print(0.1_decimal + 0.2_decimal == 0.3_decimal)
    print(0.1 + 0.2 == 0.3)
    print(sum as double)
    print(sum as int)
    print(1.5 as decimal)
}
