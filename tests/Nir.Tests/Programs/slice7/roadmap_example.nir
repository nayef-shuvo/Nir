type Point = struct {
    x: int,
    y: int,
}

Point impl {
    fn new(x: int, y: int) -> Self {
        return Self { x = x, y = y }
    }

    fn length_squared(&self) -> int {
        return self.x * self.x + self.y * self.y
    }

    fn move_right(&mut self) {
        self.x = self.x + 1
    }
}

fn bump(p: &mut Point) {
    p.y = p.y + 1
}

fn main() {
    let mut p = Point::new(3, 4)
    p.move_right()
    bump(&mut p)
    print(p.length_squared())
    let q = p
    p.x = 10
    print(q.x)
    print(p.x)
}
