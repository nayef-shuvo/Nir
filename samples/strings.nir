// Joining, comparing and formatting text.
fn describe(name: string, age: int) -> string {
    return name + " is " + age.ToString() + " years old"
}

fn main() {
    let name = "Nir"
    let n = 42
    let ratio = 7.5

    print("Hello, " + name + "!")
    print($"{name} has n = {n} and ratio = {ratio}")
    print($"even: {n % 2 == 0}, shout: {name.ToUpper()}")
    print($"{{braces}} are written twice, and a tab\there")
    print("quote: \" backslash: \\")
    print("a" == "a")                       // True: the characters are compared
    print(describe("Ada", 36))

    let mut line = ""
    for i in 1..=5 {
        line = line + $"{i * i} "
    }
    print(line.Trim())                      // 1 4 9 16 25
}
