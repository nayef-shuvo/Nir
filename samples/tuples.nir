// Tuples: a few values travelling together. Elements are reached by index (`t.0`) or, if named, by name.
type Pair = (x: int, y: int)

type Segment = struct {
    ends: (Pair, Pair)
    label: string
}

fn divmod(a: int, b: int) -> (quotient: int, remainder: int) {
    return (a / b, a % b)
}

fn swap(p: Pair) -> Pair {
    return (p.y, p.x)
}

fn main() {
    let t = (1, 2.5, "three")
    print(t.2)

    let (q, r) = divmod(17, 5)
    print($"17 = 5 * {q} + {r}")
    let both = divmod(9, 2)
    print(both.quotient)

    let mut p: Pair = (1, 2)
    p.x = 10
    let q2 = swap(p)
    print($"{q2.x} {q2.y}")

    let (first, _) = (p, 99)
    print(first.x)

    let mut line = Segment { ends = ((0, 0), (3, 4)), label = "diagonal" }
    line.ends.1.x = 6
    print(line.ends.1.x + line.ends.1.y)
}
