// if / else if / else, while, for, break, continue, and the boolean operators && || !
fn main() {
    let limit = 20
    let mut total = 0

    for i in 0..limit {              // i = 0, 1, ... 19 (the end is not included)
        if i % 2 == 0 {
            continue                 // skip the even numbers
        }
        total = total + i
    }
    print(total)                     // 100: the odd numbers below 20

    for i in 1..=3 {                 // ..= includes the end
        print(i)
    }

    let mut n = 27
    let mut steps = 0
    while n != 1 {
        if n % 2 == 0 {
            n = n / 2
        } else if n > 1000000 && steps > 500 {
            break                    // never reached, but shows break
        } else {
            n = 3 * n + 1
        }
        steps = steps + 1
    }
    print(steps)                     // 111

    let ready = steps > 100
    if ready && !(total < 0) {
        print("ready")
    }
}
