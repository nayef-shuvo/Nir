{
  "name": "nir",
  "displayName": "Nir",
  "description": "Syntax highlighting for the Nir programming language",
  "version": "0.1.5",
  "publisher": "nir",
  "license": "UNLICENSED",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "nir",
        "aliases": [
          "Nir",
          "nir"
        ],
        "extensions": [
          ".nir"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/file-icon.svg",
          "dark": "./images/file-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "nir",
        "scopeName": "source.nir",
        "path": "./syntaxes/nir.tmLanguage.json"
      }
    ]
  }
}
